{
  "name": "ritual-agent-defense",
  "displayName": "Ritual Agent Defense",
  "description": "Unified AI Agent Runtime Defense, Kernel Sandboxing, Database Guardrails & Context Optimizer for Cursor, VS Code, and Windsurf",
  "version": "0.3.0",
  "publisher": "ritualdev-lab",
  "repository": {
    "type": "git",
    "url": "https://github.com/RitualDev-Lab/ritual-agent-defense"
  },
  "homepage": "https://github.com/RitualDev-Lab/ritual-agent-defense#readme",
  "bugs": {
    "url": "https://github.com/RitualDev-Lab/ritual-agent-defense/issues"
  },
  "license": "MIT",
  "categories": [
    "AI",
    "Security",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "cursor",
    "mcp",
    "agentshield",
    "dbshield",
    "skillprism",
    "devshelf",
    "guardrails",
    "sandbox",
    "windsurf"
  ],
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ritual-mesh",
          "title": "Ritual Agent Defense",
          "icon": "media/shield.svg"
        }
      ]
    },
    "views": {
      "ritual-mesh": [
        {
          "type": "webview",
          "id": "ritual.approvalsView",
          "name": "1-Click Approvals & Shield Gate",
          "icon": "$(shield)"
        },
        {
          "type": "webview",
          "id": "ritual.tokenVisualizerView",
          "name": "SkillPrism Token Savings",
          "icon": "$(zap)"
        },
        {
          "type": "webview",
          "id": "ritual.devshelfView",
          "name": "DevShelf MCP Tool Catalog",
          "icon": "$(package)"
        },
        {
          "id": "ritual.meshStatusView",
          "name": "Agent Mesh & Sandbox Health",
          "icon": "$(pulse)"
        },
        {
          "id": "ritual.polyWorkspaceView",
          "name": "Poly Monorepo & Task Graph",
          "icon": "$(project)"
        },
        {
          "id": "ritual.polyHealthView",
          "name": "Poly Ecosystem Health",
          "icon": "$(heart)"
        }
      ]
    },
    "commands": [
      {
        "command": "ritual.refreshAll",
        "title": "Ritual: Refresh Mesh Status",
        "icon": "$(refresh)"
      },
      {
        "command": "ritual.openDashboard",
        "title": "Ritual: Open Live Approval Feed Dashboard",
        "icon": "$(link-external)"
      },
      {
        "command": "ritual.approveMutation",
        "title": "Ritual: 1-Click Approve Mutation"
      },
      {
        "command": "ritual.rejectMutation",
        "title": "Ritual: Reject Mutation"
      },
      {
        "command": "ritual.browseDevShelf",
        "title": "Ritual: Browse DevShelf MCP Directory"
      },
      {
        "command": "ritual.configureMcp",
        "title": "Ritual: Add Tool to Cursor / Claude mcp.json"
      },
      {
        "command": "ritual.dbshield.startProxy",
        "title": "DBShield: Launch PostgreSQL Wire Proxy (:5433)",
        "icon": "$(server-process)"
      },
      {
        "command": "ritual.dbshield.topMonitor",
        "title": "DBShield: Launch Interactive Terminal Monitor (top)",
        "icon": "$(dashboard)"
      },
      {
        "command": "ritual.dbshield.auditWorkspace",
        "title": "DBShield: Audit Workspace Migrations & Lock Hazards",
        "icon": "$(shield)"
      },
      {
        "command": "ritual.dbshield.openSimulator",
        "title": "DBShield: Open Interactive SQL Guardrail Simulator",
        "icon": "$(play)"
      },
      {
        "command": "ritual.dbshield.configureMcp",
        "title": "DBShield: 1-Click Configure Cursor / Antigravity MCP",
        "icon": "$(tools)"
      },
      {
        "command": "ritual.agentshield.scanActiveFile",
        "title": "AgentShield: Scan Active File for Secrets & DLP Leaks",
        "icon": "$(shield)"
      },
      {
        "command": "ritual.agentshield.auditWorkspace",
        "title": "AgentShield: Audit Entire Workspace with Security Enforcer",
        "icon": "$(search)"
      },
      {
        "command": "ritual.agentshield.switchSandboxProfile",
        "title": "AgentShield: Switch OS Kernel Sandbox Profile",
        "icon": "$(lock)"
      },
      {
        "command": "ritual.agentshield.showStatusMenu",
        "title": "AgentShield: Show Zero-Leak Defense Status & Actions"
      },
      {
        "command": "ritual.poly.refresh",
        "title": "Poly: Refresh Workspace & Ecosystem Health",
        "icon": "$(refresh)"
      },
      {
        "command": "ritual.poly.install",
        "title": "Poly: Install & Synchronize Polyglot Dependencies",
        "icon": "$(cloud-download)"
      },
      {
        "command": "ritual.poly.audit",
        "title": "Poly: Audit Monorepo Security Vulnerabilities",
        "icon": "$(shield)"
      },
      {
        "command": "ritual.poly.fix",
        "title": "Poly: Auto-Heal Vulnerabilities & Regenerate Lockfile",
        "icon": "$(wrench)"
      },
      {
        "command": "ritual.poly.doctor",
        "title": "Poly: Run Multi-Ecosystem System Diagnostics",
        "icon": "$(pulse)"
      },
      {
        "command": "ritual.poly.graph",
        "title": "Poly: Visualize Monorepo Task Dependency Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "ritual.poly.docker",
        "title": "Poly: Generate Multi-Stage Container & DevContainer",
        "icon": "$(package)"
      },
      {
        "command": "ritual.poly.addDependency",
        "title": "Poly: Add Polyglot Dependency via PURL"
      },
      {
        "command": "ritual.poly.verifyLockfile",
        "title": "Poly: Verify poly.lock Cryptographic Integrity"
      },
      {
        "command": "ritual.poly.cacheStatus",
        "title": "Poly: Inspect Live Remote Cache Cluster Status"
      },
      {
        "command": "ritual.poly.cachePurge",
        "title": "Poly: Purge Remote Cache for Current Monorepo Branch"
      },
      {
        "command": "ritual.gitwhisper.generateCommit",
        "title": "GitWhisper: Generate AI Conventional Commit Message",
        "icon": "$(sparkle)"
      },
      {
        "command": "ritual.gitwhisper.checkQuality",
        "title": "GitWhisper: Check Staged Commit Quality & Formatting",
        "icon": "$(check)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "ritual.gitwhisper.generateCommit",
          "group": "navigation@1",
          "when": "scmRepositoryCount > 0"
        }
      ],
      "scm/inputBox": [
        {
          "command": "ritual.gitwhisper.generateCommit",
          "group": "inline",
          "when": "scmRepositoryCount > 0"
        }
      ],
      "view/title": [
        {
          "command": "ritual.refreshAll",
          "when": "view == ritual.approvalsView || view == ritual.meshStatusView || view == ritual.tokenVisualizerView",
          "group": "navigation"
        },
        {
          "command": "ritual.poly.refresh",
          "when": "view == ritual.polyWorkspaceView || view == ritual.polyHealthView",
          "group": "navigation"
        },
        {
          "command": "ritual.openDashboard",
          "when": "view == ritual.approvalsView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Ritual Agent Defense",
      "properties": {
        "ritual.dbshieldUrl": {
          "type": "string",
          "default": "http://localhost:3100",
          "description": "DBShield live approval and defense dashboard URL."
        },
        "ritual.sandboxEngine": {
          "type": "string",
          "enum": [
            "auto",
            "Seatbelt (macOS)",
            "bwrap (Linux)",
            "AppContainer (Windows)"
          ],
          "default": "auto",
          "description": "Active kernel sandbox profile to enforce for agent subprocesses."
        },
        "ritual.skillprismEndpoint": {
          "type": "string",
          "default": "http://localhost:6379",
          "description": "SkillPrism tool optimizer and federated cache endpoint."
        },
        "ritual.autoRefreshIntervalMs": {
          "type": "number",
          "default": 3000,
          "description": "Interval in milliseconds to poll pending approvals and mesh status."
        },
        "ritual.notifications": {
          "type": "boolean",
          "default": true,
          "description": "Show system pop-up notifications when agents request mutation approvals."
        },
        "poly.executablePath": {
          "type": "string",
          "default": "poly",
          "description": "Path to poly CLI binary or global executable."
        },
        "poly.remoteCacheUrl": {
          "type": "string",
          "default": "https://api.poly.build",
          "description": "Hosted or enterprise self-hosted Poly remote cache cluster URL."
        },
        "gitwhisper.model": {
          "type": "string",
          "default": "local-deterministic",
          "description": "Model engine used for conventional commit message synthesis."
        },
        "gitwhisper.redactSecrets": {
          "type": "boolean",
          "default": true,
          "description": "Automatically redact API keys, tokens, and PII from generated commit messages."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "tsc -p ./",
    "package": "vsce package --no-dependencies",
    "publish:vscode": "vsce publish",
    "publish:openvsx": "ovsx publish",
    "test": "tsx --test \"tests/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "ovsx": "^0.8.3",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
  }
}
